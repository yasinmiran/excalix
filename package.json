{
  "name": "excalix",
  "version": "0.2.0",
  "description": "Architecture diagrams from a topology spec, rendered in Excalidraw's hand-drawn style. CLI and MCP.",
  "keywords": [
    "mcp",
    "mcp-server",
    "excalidraw",
    "diagram",
    "architecture"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Yasin Miran",
  "packageManager": "pnpm@9.12.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yasinmiran/excalix.git"
  },
  "homepage": "https://yasinmiran.github.io/excalix/",
  "bugs": "https://github.com/yasinmiran/excalix/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "excalix": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@excalidraw/utils": "0.1.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "elkjs": "0.12.0",
    "playwright-core": "1.63.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "0.18.0-afa3a65",
    "@types/node": "22.20.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
