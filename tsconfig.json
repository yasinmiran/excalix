{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "excalidraw-types/*": ["node_modules/@excalidraw/utils/dist/types/*"],
      "@excalidraw/common": ["node_modules/@excalidraw/utils/dist/types/common/src/index.d.ts"],
      "@excalidraw/common/*": ["node_modules/@excalidraw/utils/dist/types/common/src/*"],
      "@excalidraw/element": ["node_modules/@excalidraw/utils/dist/types/element/src/index.d.ts"],
      "@excalidraw/element/*": ["node_modules/@excalidraw/utils/dist/types/element/src/*"],
      "@excalidraw/excalidraw/*": ["node_modules/@excalidraw/utils/dist/types/excalidraw/*"],
      "@excalidraw/math": ["node_modules/@excalidraw/utils/dist/types/math/src/index.d.ts"],
      "@excalidraw/math/*": ["node_modules/@excalidraw/utils/dist/types/math/src/*"]
    }
  },
  "include": ["src"]
}
